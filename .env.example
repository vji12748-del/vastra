# VASTRA environment variables — template
# Copy this file as `.env` (local dev) OR paste values in Render dashboard
# (Environment tab) for production. NEVER commit the real .env to GitHub.

# MongoDB connection string
# Local (sandbox default — optional, ye likha na ho toh bhi local chalega):
#   MONGO_URI=mongodb://127.0.0.1:27017/vastra
# Production (MongoDB Atlas — dashboard me set karo):
#   MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vastra

# Server port (Render par PORT automatically set hota hai — mat likhna)
# PORT=3000

# Environment
# NODE_ENV=production

# Session lifetime in days (optional, default 7)
# SESSION_DAYS=7
